              <calculation class="tableau" formula="&quot;unit668&quot;" />
            </column>
            <column caption="Cover type" datatype="string" name="[LandClass]" param-domain-type="list" role="measure" type="nominal" value="&quot;Treed native vegetation&quot;">
              <calculation class="tableau" formula="&quot;Treed native vegetation&quot;" />
            </column>
            <column caption="Earlier period" datatype="string" name="[StartEpoch]" param-domain-type="list" role="measure" type="nominal" value="&quot;1985-1990&quot;">
              <calculation class="tableau" formula="&quot;1985-1990&quot;" />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource="federated.landcover">
            <column caption="Classmatch" datatype="boolean" name="[ClassMatch]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[class_label] = [Parameters].[LandClass]" />
            </column>
            <column caption="Comparematch" datatype="boolean" name="[CompareMatch]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[microID] = [Parameters].[FocusArea] OR [microID] = [Parameters].[Compare1] OR [microID] = [Parameters].[Compare2] OR [microID] = [Parameters].[Compare3]" />
            </column>
            <column caption="Endpointmatch" datatype="boolean" name="[EndpointMatch]" role="dimension" type="nominal">
              <calculation class="tableau" formula="INT(LEFT([Parameters].[StartEpoch],4)) &lt; INT(LEFT([Parameters].[EndEpoch],4)) AND ([epoch_label] = [Parameters].[StartEpoch] OR [epoch_label] = [Parameters].[EndEpoch])" />
            </column>
            <column caption="Period being compared" datatype="string" name="[IntervalRole]" role="dimension" type="nominal">
              <calculation class="tableau" formula="IF [epoch_label] = [Parameters].[StartEpoch] THEN &quot;Earlier period&quot; ELSEIF [epoch_label] = [Parameters].[EndEpoch] THEN &quot;Later period&quot; ELSE &quot;Other period&quot; END" />
            </column>
            <column caption="Land covered (hectares)" datatype="real" name="[area_ha]" role="measure" type="quantitative" />
            <column caption="Cover type" datatype="string" name="[class_label]" role="dimension" type="nominal" />
            <column caption="Area with classified data (%)" datatype="real" name="[coverage_pct]" role="measure" type="quantitative" />
            <column caption="Historical period" datatype="string" name="[epoch_label]" role="dimension" type="nominal" />
            <column caption="Area ID" datatype="string" name="[microID]" role="dimension" type="nominal" />
            <column caption="Missing data (hectares)" datatype="real" name="[nodata_area_ha]" role="measure" type="quantitative" />
            <column-instance column="[ClassMatch]" derivation="None" name="[none:ClassMatch:nk]" pivot="key" type="nominal" />
            <column-instance column="[CompareMatch]" derivation="None" name="[none:CompareMatch:nk]" pivot="key" type="nominal" />
            <column-instance column="[EndpointMatch]" derivation="None" name="[none:EndpointMatch:nk]" pivot="key" type="nominal" />
            <column-instance column="[IntervalRole]" derivation="None" name="[none:IntervalRole:nk]" pivot="key" type="nominal" />
            <column-instance column="[class_label]" derivation="None" name="[none:class_label:nk]" pivot="key" type="nominal" />
            <column-instance column="[epoch_label]" derivation="None" name="[none:epoch_label:nk]" pivot="key" type="nominal" />
            <column-instance column="[microID]" derivation="None" name="[none:microID:nk]" pivot="key" type="nominal" />
            <column-instance column="[unit_label]" derivation="None" name="[none:unit_label:nk]" pivot="key" type="nominal" />
            <column caption="Land covered (%)" datatype="real" name="[share_pct]" role="measure" type="quantitative" />
            <column-instance column="[area_ha]" derivation="Sum" name="[sum:area_ha:qk]" pivot="key" type="quantitative" />
            <column-instance column="[coverage_pct]" derivation="Sum" name="[sum:coverage_pct:qk]" pivot="key" type="quantitative" />
            <column-instance column="[nodata_area_ha]" derivation="Sum" name="[sum:nodata_area_ha:qk]" pivot="key" type="quantitative" />
            <column-instance column="[share_pct]" derivation="Sum" name="[sum:share_pct:qk]" pivot="key" type="quantitative" />
            <column-instance column="[unclassified_area_ha]" derivation="Sum" name="[sum:unclassified_area_ha:qk]" pivot="key" type="quantitative" />
            <column caption="Unclassified land (hectares)" datatype="real" name="[unclassified_area_ha]" role="measure" type="quantitative" />
            <column caption="Area" datatype="string" name="[unit_label]" role="dimension" type="nominal" />
          </datasource-dependencies>
          <filter class="categorical" column="[federated.landcover].[none:ClassMatch:nk]">
            <groupfilter function="member" level="[none:ClassMatch:nk]" member="true" />
          </filter>
          <filter class="categorical" column="[federated.landcover].[none:CompareMatch:nk]">
            <groupfilter function="member" level="[none:CompareMatch:nk]" member="true" />
          </filter>
          <filter class="categorical" column="[federated.landcover].[none:EndpointMatch:nk]">
            <groupfilter function="member" level="[none:EndpointMatch:nk]" member="true" />
          </filter>
          <slices>

            <column-instance column="[microID]" derivation="None" name="[none:microID:nk]" pivot="key" type="nominal" />
            <column-instance column="[unit_label]" derivation="None" name="[none:unit_label:nk]" pivot="key" type="nominal" />
            <column-instance column="[epoch_id]" derivation="None" name="[none:epoch_id:nk]" pivot="key" type="nominal" />
            <column-instance column="[epoch_label]" derivation="None" name="[none:epoch_label:nk]" pivot="key" type="nominal" />
            <column-instance column="[epoch_start]" derivation="Sum" name="[sum:epoch_start:qk]" pivot="key" type="quantitative" />
            <column-instance column="[epoch_end]" derivation="Sum" name="[sum:epoch_end:qk]" pivot="key" type="quantitative" />
            <column-instance column="[class_code]" derivation="Sum" name="[sum:class_code:qk]" pivot="key" type="quantitative" />
            <column-instance column="[class_label]" derivation="None" name="[none:class_label:nk]" pivot="key" type="nominal" />
            <column-instance column="[class_group]" derivation="None" name="[none:class_group:nk]" pivot="key" type="nominal" />
            <column-instance column="[area_ha]" derivation="Sum" name="[sum:area_ha:qk]" pivot="key" type="quantitative" />
            <column-instance column="[share_pct]" derivation="Sum" name="[sum:share_pct:qk]" pivot="key" type="quantitative" />
            <column-instance column="[valid_area_ha]" derivation="Min" name="[min:valid_area_ha:qk]" pivot="key" type="quantitative" />
            <column-instance column="[coverage_pct]" derivation="Min" name="[min:coverage_pct:qk]" pivot="key" type="quantitative" />
            <column-instance column="[unclassified_area_ha]" derivation="Min" name="[min:unclassified_area_ha:qk]" pivot="key" type="quantitative" />
            <column-instance column="[nodata_area_ha]" derivation="Min" name="[min:nodata_area_ha:qk]" pivot="key" type="quantitative" />
            <column-instance column="[data_release]" derivation="None" name="[none:data_release:nk]" pivot="key" type="nominal" />

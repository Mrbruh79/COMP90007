  <worksheets>
    <worksheet name="T01_Composition">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontsize="13" fontname="Segoe UI" fontcolor="#203c32">Composition of the selected area</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Victoria land cover by SMP summary area" name="federated.landcover" />
            <datasource name="Parameters" />
          </datasources>
          <datasource-dependencies datasource="Parameters">
            <column caption="Trend measure" datatype="string" name="[TrendMode]" param-domain-type="list" role="measure" type="nominal" value="&quot;Cover share (%)&quot;">
              <calculation class="tableau" formula="&quot;Cover share (%)&quot;" />
            </column>
            <column caption="Data release" datatype="string" name="[DataRelease]" param-domain-type="any" role="measure" type="nominal" value="&quot;VLCTS2020-027b466b6417-999c1a16&quot;">
              <calculation class="tableau" formula="&quot;VLCTS2020-027b466b6417-999c1a16&quot;" />
            </column>
            <column caption="Main area" datatype="string" name="[FocusArea]" param-domain-type="list" role="measure" type="nominal" value="&quot;unit668&quot;">
              <calculation class="tableau" formula="&quot;unit668&quot;" />
            </column>
            <column caption="Composition view" datatype="string" name="[FocusView]" param-domain-type="list" role="measure" type="nominal" value="&quot;Grouped overview&quot;">
              <calculation class="tableau" formula="&quot;Grouped overview&quot;" />
            </column>
            <column caption="Additional area 1 (optional)" datatype="string" name="[Compare1]" param-domain-type="list" role="measure" type="nominal" value="&quot;unit375&quot;">
              <calculation class="tableau" formula="&quot;unit375&quot;" />
            </column>
            <column caption="Additional area 2 (optional)" datatype="string" name="[Compare2]" param-domain-type="list" role="measure" type="nominal" value="&quot;&quot;">
              <calculation class="tableau" formula="&quot;&quot;" />
            </column>
            <column caption="Additional area 3 (optional)" datatype="string" name="[Compare3]" param-domain-type="list" role="measure" type="nominal" value="&quot;&quot;">
              <calculation class="tableau" formula="&quot;&quot;" />
            </column>
            <column caption="Cover type" datatype="string" name="[LandClass]" param-domain-type="list" role="measure" type="nominal" value="&quot;Treed native vegetation&quot;">
              <calculation class="tableau" formula="&quot;Treed native vegetation&quot;" />
            </column>
            <column caption="Earlier period" datatype="string" name="[StartEpoch]" param-domain-type="list" role="measure" type="nominal" value="&quot;1985-1990&quot;">
              <calculation class="tableau" formula="&quot;1985-1990&quot;" />
            </column>
            <column caption="Later period" datatype="string" name="[EndEpoch]" param-domain-type="list" role="measure" type="nominal" value="&quot;2015-2019&quot;">
              <calculation class="tableau" formula="&quot;2015-2019&quot;" />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource="federated.landcover">
            <column caption="Area" datatype="string" name="[AreaSeries]" role="dimension" type="nominal">
              <calculation class="tableau" formula="(IF [microID] = [Parameters].[FocusArea] THEN &quot;Main | &quot; ELSEIF [microID] = [Parameters].[Compare1] THEN &quot;Pin 1 | &quot; ELSEIF [microID] = [Parameters].[Compare2] THEN &quot;Pin 2 | &quot; ELSE &quot;Pin 3 | &quot; END) + [unit_label]" />
            </column>
            <column caption="Period" datatype="string" name="[EpochDisplay]" role="dimension" type="nominal">
              <calculation class="tableau" formula="LEFT([epoch_label],4) + &quot;/&quot; + RIGHT([epoch_label],2)" />
            </column>
            <column caption="Focusmatch" datatype="boolean" name="[FocusMatch]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[microID] = [Parameters].[FocusArea]" />
            </column>
            <column caption="Focusviewmatch" datatype="boolean" name="[FocusViewMatch]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[Parameters].[FocusView] &lt;&gt; &quot;Selected cover type&quot; OR [class_label] = [Parameters].[LandClass]" />
            </column>
            <column caption="Cover group / class" datatype="string" name="[DisplayClass]" role="dimension" type="nominal">
              <calculation class="tableau" formula="IF [Parameters].[FocusView] &lt;&gt; &quot;Grouped overview&quot; THEN TRIM(REPLACE([class_label],&quot; - &quot;,&quot; &quot;)) ELSE CASE [class_code] WHEN 1 THEN &quot;Developed / disturbed&quot; WHEN 2 THEN &quot;Developed / disturbed&quot; WHEN 3 THEN &quot;Developed / disturbed&quot; WHEN 4 THEN &quot;Agriculture&quot; WHEN 5 THEN &quot;Agriculture&quot; WHEN 8 THEN &quot;Agriculture&quot; WHEN 7 THEN &quot;Plantations / exotic trees&quot; WHEN 15 THEN &quot;Plantations / exotic trees&quot; WHEN 6 THEN &quot;Plantations / exotic trees&quot; WHEN 14 THEN &quot;Natural low cover&quot; WHEN 17 THEN &quot;Open water&quot; WHEN 9 THEN &quot;Wetland vegetation&quot; WHEN 16 THEN &quot;Wetland vegetation&quot; WHEN 18 THEN &quot;Wetland vegetation&quot; WHEN 19 THEN &quot;Wetland vegetation&quot; ELSE &quot;Other native vegetation&quot; END END" />
            </column>
            <column caption="Changelabel" datatype="string" name="[ChangeLabel]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(SUM([EarlierShare]),1)) + &quot;% to &quot; + STR(ROUND(SUM([LaterShare]),1)) + &quot;%   |   &quot; + IF ROUND(SUM([ChangePP]),1) &gt; 0 THEN &quot;+&quot; ELSE &quot;&quot; END + STR(ROUND(SUM([ChangePP]),1)) + &quot; pp&quot;" />
            </column>
            <column caption="Earlier cover (%)" datatype="real" name="[EarlierShare]" role="measure" type="quantitative" default-format="0.0&quot;%&quot;">
              <calculation class="tableau" formula="IF [epoch_label] = [Parameters].[StartEpoch] THEN [share_pct] END" />
            </column>
            <column caption="Later cover (%)" datatype="real" name="[LaterShare]" role="measure" type="quantitative" default-format="0.0&quot;%&quot;">
              <calculation class="tableau" formula="IF [epoch_label] = [Parameters].[EndEpoch] THEN [share_pct] END" />
            </column>
            <column caption="Change (percentage points)" datatype="real" name="[ChangePP]" role="measure" type="quantitative" default-format="+0.0&quot; pp&quot;;-0.0&quot; pp&quot;;0.0&quot; pp&quot;">
              <calculation class="tableau" formula="IF [epoch_label] = [Parameters].[EndEpoch] THEN [share_pct] ELSEIF [epoch_label] = [Parameters].[StartEpoch] THEN -[share_pct] END" />
            </column>
            <column caption="Cover share (%) / baseline change (pp)" datatype="real" name="[TrendValue]" role="measure" type="quantitative">
              <calculation class="tableau" formula="IF [Parameters].[TrendMode] = &quot;Cover share (%)&quot; THEN [share_pct] ELSE [share_pct] - { FIXED [microID], [class_label] : MIN(IF [epoch_label] = &quot;1985-1990&quot; THEN [share_pct] END) } END" />
            </column>
            <column caption="Comparematch" datatype="boolean" name="[CompareMatch]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[microID] = [Parameters].[FocusArea] OR [microID] = [Parameters].[Compare1] OR [microID] = [Parameters].[Compare2] OR [microID] = [Parameters].[Compare3]" />
            </column>
            <column caption="Classmatch" datatype="boolean" name="[ClassMatch]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[class_label] = [Parameters].[LandClass]" />
            </column>
            <column caption="Endpointmatch" datatype="boolean" name="[EndpointMatch]" role="dimension" type="nominal">
              <calculation class="tableau" formula="INT(LEFT([Parameters].[StartEpoch],4)) &lt; INT(LEFT([Parameters].[EndEpoch],4)) AND ([epoch_label] = [Parameters].[StartEpoch] OR [epoch_label] = [Parameters].[EndEpoch])" />
            </column>
            <column caption="Period being compared" datatype="string" name="[IntervalRole]" role="dimension" type="nominal">
              <calculation class="tableau" formula="IF [epoch_label] = [Parameters].[StartEpoch] THEN &quot;Earlier period&quot; ELSEIF [epoch_label] = [Parameters].[EndEpoch] THEN &quot;Later period&quot; ELSE &quot;Other period&quot; END" />
            </column>
            <column caption="Area ID" datatype="string" name="[microID]" role="dimension" type="nominal" />
            <column caption="Area" datatype="string" name="[unit_label]" role="dimension" type="nominal" />
            <column caption="Epoch id" datatype="string" name="[epoch_id]" role="dimension" type="nominal" />
            <column caption="Historical period" datatype="string" name="[epoch_label]" role="dimension" type="nominal" />
            <column caption="Epoch start" datatype="integer" name="[epoch_start]" role="measure" type="quantitative" />
            <column caption="Epoch end" datatype="integer" name="[epoch_end]" role="measure" type="quantitative" />
            <column caption="Class code" datatype="integer" name="[class_code]" role="measure" type="quantitative" />
            <column caption="Cover type" datatype="string" name="[class_label]" role="dimension" type="nominal" />
            <column caption="Class group" datatype="string" name="[class_group]" role="dimension" type="nominal" />
            <column caption="Land covered (hectares)" datatype="real" name="[area_ha]" role="measure" type="quantitative" default-format="#,##0.0" />
            <column caption="Cover (%)" datatype="real" name="[share_pct]" role="measure" type="quantitative" />
            <column caption="Valid area ha" datatype="real" name="[valid_area_ha]" role="measure" type="quantitative" default-format="#,##0.0" />
            <column caption="Area with classified data (%)" datatype="real" name="[coverage_pct]" role="measure" type="quantitative" />
            <column caption="Unclassified land (hectares)" datatype="real" name="[unclassified_area_ha]" role="measure" type="quantitative" default-format="#,##0.0" />
            <column caption="Missing data (hectares)" datatype="real" name="[nodata_area_ha]" role="measure" type="quantitative" default-format="#,##0.0" />
            <column caption="Data release" datatype="string" name="[data_release]" role="dimension" type="nominal" />
            <column-instance column="[AreaSeries]" derivation="None" name="[none:AreaSeries:nk]" pivot="key" type="nominal" />
            <column-instance column="[EpochDisplay]" derivation="None" name="[none:EpochDisplay:nk]" pivot="key" type="nominal" />
            <column-instance column="[FocusMatch]" derivation="None" name="[none:FocusMatch:nk]" pivot="key" type="nominal" />
            <column-instance column="[FocusViewMatch]" derivation="None" name="[none:FocusViewMatch:nk]" pivot="key" type="nominal" />
            <column-instance column="[DisplayClass]" derivation="None" name="[none:DisplayClass:nk]" pivot="key" type="nominal" />
            <column-instance column="[ChangeLabel]" derivation="User" name="[usr:ChangeLabel:nk]" pivot="key" type="nominal" />
            <column-instance column="[EarlierShare]" derivation="Sum" name="[sum:EarlierShare:qk]" pivot="key" type="quantitative" />
            <column-instance column="[LaterShare]" derivation="Sum" name="[sum:LaterShare:qk]" pivot="key" type="quantitative" />
            <column-instance column="[ChangePP]" derivation="Sum" name="[sum:ChangePP:qk]" pivot="key" type="quantitative" />
            <column-instance column="[TrendValue]" derivation="Sum" name="[sum:TrendValue:qk]" pivot="key" type="quantitative" />
            <column-instance column="[CompareMatch]" derivation="None" name="[none:CompareMatch:nk]" pivot="key" type="nominal" />
            <column-instance column="[ClassMatch]" derivation="None" name="[none:ClassMatch:nk]" pivot="key" type="nominal" />
            <column-instance column="[EndpointMatch]" derivation="None" name="[none:EndpointMatch:nk]" pivot="key" type="nominal" />

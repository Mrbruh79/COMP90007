        <column caption="Cover type" datatype="string" name="[LandClass]" param-domain-type="list" role="measure" type="nominal" value="&quot;Treed native vegetation&quot;">
          <calculation class="tableau" formula="&quot;Treed native vegetation&quot;" />
          <members>
            <member value="&quot;Built environment&quot;" alias="Built environment" />
            <member value="&quot;Urban area&quot;" alias="Urban area" />
            <member value="&quot;Disturbed ground&quot;" alias="Disturbed ground" />
            <member value="&quot;Exotic pasture / grassland&quot;" alias="Exotic pasture / grassland" />
            <member value="&quot;Dryland cropping&quot;" alias="Dryland cropping" />
            <member value="&quot;Other exotic tree cover&quot;" alias="Other exotic tree cover" />
            <member value="&quot;Hardwood plantation&quot;" alias="Hardwood plantation" />
            <member value="&quot;Horticulture / irrigated pastures and crops&quot;" alias="Horticulture / irrigated pastures and crops" />
            <member value="&quot;Mangrove vegetation&quot;" alias="Mangrove vegetation" />
            <member value="&quot;Native pasture / grassland&quot;" alias="Native pasture / grassland" />
            <member value="&quot;Native scrubland&quot;" alias="Native scrubland" />
            <member value="&quot;Treed native vegetation&quot;" alias="Treed native vegetation" />
            <member value="&quot;Scattered native trees&quot;" alias="Scattered native trees" />
            <member value="&quot;Natural low cover&quot;" alias="Natural low cover" />
            <member value="&quot;Conifer plantation&quot;" alias="Conifer plantation" />
            <member value="&quot;Saltmarsh vegetation&quot;" alias="Saltmarsh vegetation" />
            <member value="&quot;Water&quot;" alias="Water" />
            <member value="&quot;Wetland - seasonal&quot;" alias="Wetland seasonal" />
            <member value="&quot;Wetland - perennial&quot;" alias="Wetland perennial" />
          </members>
        </column>
        <column caption="Earlier period" datatype="string" name="[StartEpoch]" param-domain-type="list" role="measure" type="nominal" value="&quot;1985-1990&quot;">
          <calculation class="tableau" formula="&quot;1985-1990&quot;" />
          <members>

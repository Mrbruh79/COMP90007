            <formatted-text>
              <run bold="true" fontcolor="#193f36" fontsize="14">Add comparisons
</run>
              <run fontcolor="#495d56" fontsize="11">Leave unused slots blank.</run>
            </formatted-text>
            <zone-style>
              <format attr="border-color" value="#000000" />
              <format attr="border-style" value="none" />
              <format attr="border-width" value="0" />
              <format attr="margin" value="12" />
              <format attr="background-color" value="#e2ebe5" />
            </zone-style>
          </zone>
          <zone h="3855" id="14" mode="compact" param="[Parameters].[Compare1]" type-v2="paramctrl" w="17571" x="2857" y="30241">
            <zone-style>
              <format attr="border-color" value="#000000" />
              <format attr="border-style" value="none" />
              <format attr="border-width" value="0" />
              <format attr="margin" value="8" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone h="3855" id="15" mode="compact" param="[Parameters].[Compare2]" type-v2="paramctrl" w="17571" x="2857" y="34940">
            <zone-style>
              <format attr="border-color" value="#000000" />
              <format attr="border-style" value="none" />
              <format attr="border-width" value="0" />
              <format attr="margin" value="8" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone h="3855" id="16" mode="compact" param="[Parameters].[Compare3]" type-v2="paramctrl" w="17571" x="2857" y="39639">
            <zone-style>
              <format attr="border-color" value="#000000" />
              <format attr="border-style" value="none" />
              <format attr="border-width" value="0" />
              <format attr="margin" value="8" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone h="10241" id="9" type-v2="text" w="17571" x="2857" y="45783">
            <formatted-text>
              <run bold="true" fontcolor="#193f36" fontsize="14">What does the % mean?
</run>
              <run fontcolor="#495d56" fontsize="11">40% = 40 of every 100 classified hectares.

unit668 is an area ID, not a rank.</run>
            </formatted-text>
            <zone-style>
              <format attr="border-color" value="#000000" />
              <format attr="border-style" value="none" />
              <format attr="border-width" value="0" />
              <format attr="margin" value="12" />
              <format attr="background-color" value="#e2ebe5" />
            </zone-style>
          </zone>
          <zone h="10843" id="18" type-v2="text" w="17571" x="2857" y="57590">
            <formatted-text>
              <run bold="true" fontcolor="#193f36" fontsize="14">Small categories
</run>
              <run fontcolor="#495d56" fontsize="11">Chart 1: choose Selected cover type to enlarge small values.

Check its adjusted scale. Charts 2 and 3 stay at 0–100%.</run>
            </formatted-text>
            <zone-style>
              <format attr="border-color" value="#000000" />
              <format attr="border-style" value="none" />
              <format attr="border-width" value="0" />
              <format attr="margin" value="12" />
              <format attr="background-color" value="#e2ebe5" />
            </zone-style>
          </zone>
          <zone h="3855" id="17" mode="compact" param="[Parameters].[FocusView]" type-v2="paramctrl" w="27143" x="24429" y="10361">
            <zone-style>
              <format attr="border-color" value="#000000" />
              <format attr="border-style" value="none" />
              <format attr="border-width" value="0" />
              <format attr="margin" value="8" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone h="5663" id="4" type-v2="text" w="43571" x="53000" y="10361">
            <formatted-text>
              <run bold="true" fontcolor="#193f36" fontsize="14">Read the bars
</run>
              <run fontcolor="#495d56" fontsize="11">One bar per period. Colours identify cover types. All cover types totals 100%; Selected cover type uses an adjusted scale.</run>
            </formatted-text>
            <zone-style>
              <format attr="border-color" value="#000000" />
              <format attr="border-style" value="none" />
              <format attr="border-width" value="0" />
              <format attr="margin" value="12" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone h="4217" id="5" type-v2="text" w="72000" x="24429" y="47831">
            <formatted-text>
              <run fontcolor="#495d56" fontsize="11">READ THE LINES  •  Each colour identifies an area. A rising line means the selected cover type occupies a larger share of classified land. All seven periods are shown.</run>
            </formatted-text>
            <zone-style>
              <format attr="border-color" value="#000000" />
              <format attr="border-style" value="none" />
              <format attr="border-width" value="0" />
              <format attr="margin" value="12" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone h="4217" id="6" type-v2="text" w="72000" x="24429" y="73133">
            <formatted-text>
              <run fontcolor="#495d56" fontsize="11">READ THE DOTS  •  Each row is an area. Later dot to the right = increase; to the left = decrease. Overlapping dots mean equal or very close values.</run>
            </formatted-text>
            <zone-style>
              <format attr="border-color" value="#000000" />
              <format attr="border-style" value="none" />
              <format attr="border-width" value="0" />
              <format attr="margin" value="12" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone h="4819" id="19" type-v2="text" w="17571" x="2857" y="72892">
            <formatted-text>
              <run bold="true" fontcolor="#193f36" fontsize="14">Chart 3 periods
</run>
              <run fontcolor="#495d56" fontsize="11">Earlier and later maps.</run>
            </formatted-text>
            <zone-style>
              <format attr="border-color" value="#000000" />
              <format attr="border-style" value="none" />
              <format attr="border-width" value="0" />
              <format attr="margin" value="12" />
              <format attr="background-color" value="#e2ebe5" />
            </zone-style>
          </zone>
          <zone h="3855" id="12" mode="compact" param="[Parameters].[StartEpoch]" type-v2="paramctrl" w="17571" x="2857" y="77711">
            <zone-style>
              <format attr="border-color" value="#000000" />
              <format attr="border-style" value="none" />
              <format attr="border-width" value="0" />
              <format attr="margin" value="8" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone h="3855" id="13" mode="compact" param="[Parameters].[EndEpoch]" type-v2="paramctrl" w="17571" x="2857" y="82410">
            <zone-style>
              <format attr="border-color" value="#000000" />
              <format attr="border-style" value="none" />
              <format attr="border-width" value="0" />
              <format attr="margin" value="8" />
              <format attr="background-color" value="#ffffff" />
            </zone-style>
          </zone>
          <zone h="2892" id="23" type-v2="text" w="17571" x="2857" y="86988">
            <formatted-text>
              <run fontcolor="#495d56" fontsize="11">Choose the earlier period first.</run>
            </formatted-text>
            <zone-style>
              <format attr="border-color" value="#000000" />
              <format attr="border-style" value="none" />
              <format attr="border-width" value="0" />
              <format attr="margin" value="12" />
              <format attr="background-color" value="#e2ebe5" />
            </zone-style>
          </zone>
